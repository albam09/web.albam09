# Regional HTML: revalidate when revisiting after a deployment, including UTM variants.
# Netlify static assets are invalidated on new deploy; this is browser revalidation safety.
# Do NOT redirect ?utm_* or cache-bust CSS/images; retain attribution and asset caching.
/page/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  Permissions-Policy: geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)


/data/public-venues.json
  X-Robots-Tag: noindex, nosnippet

/data/public-venues.js
  X-Robots-Tag: noindex, nosnippet

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/data/*
  Cache-Control: public, max-age=3600

# Map pages with venues are indexable; empty map pages retain HTML noindex.
/map/*
  Cache-Control: public, max-age=0, must-revalidate

# Account and authoring screens: exclude both bare paths and all descendants.
# Keep these URLs crawlable so search engines can read the noindex directive.
/login
  X-Robots-Tag: noindex, nofollow

/login/*
  X-Robots-Tag: noindex, nofollow

/auth
  X-Robots-Tag: noindex

/auth/*
  X-Robots-Tag: noindex

/member
  X-Robots-Tag: noindex

/member/*
  X-Robots-Tag: noindex

/messages
  X-Robots-Tag: noindex

/messages/*
  X-Robots-Tag: noindex

/admin
  X-Robots-Tag: noindex

/admin/*
  X-Robots-Tag: noindex

/explore/write
  X-Robots-Tag: noindex

/explore/write/*
  X-Robots-Tag: noindex

/*.sql
  X-Robots-Tag: noindex, nofollow

/*SETUP*.txt
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

# SEARCH_DIRECTORY_RELEASE
/data/venue-directory.json
  X-Robots-Tag: noindex, nosnippet
/data/region-guide-content.json
  X-Robots-Tag: noindex, nosnippet
/data/release.json
  X-Robots-Tag: noindex, nosnippet
/docs/*
  X-Robots-Tag: noindex, nofollow

# Deployment identity and fresh public-post HTML.
/site-version.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/explore/*
  Cache-Control: public, max-age=0, must-revalidate
